# ── REPO SOURCE OF TRUTH — mirror of deployed host artifact ─────────────
# Host path: /etc/systemd/system/ensemble-install-snapshot.timer
# Commission: install-dir protection layers 1+3+4 (incident 891820f3 followup,
# 2026-10-12). Edit HERE, then redeploy to the host path above — see
# scripts/protection/README.md for the deployment map + enable commands.
# ────────────────────────────────────────────────────────────────────────
[Unit]
Description=Run ensemble install-tree snapshot every 30 minutes (Layer 3, 30-min cadence per plan prose; 48h retention held by the script)

[Timer]
# Cadence 30 min (plan's `hourly.{0..N}` naming was a drafting artifact — 30 min wins)
OnCalendar=*:0/30
# Catch up one missed run after downtime (bounded by script retention)
Persistent=true
AccuracySec=1min
Unit=ensemble-install-snapshot.service

[Install]
WantedBy=timers.target
