#
# Usage: sudo /usr/local/bin/ensemble-promote <allowlisted-script> [args...]
# Exit codes: 0 ok | 1 not-root | 64 usage | 66 script-not-found |
#             76 script-writable (C1 refusal) | 77 not-allowlisted (C1 refusal)
# ============================================================================
set -euo pipefail

INSTALL_DIR="/home/nea/agents-ensemble"
DEV_LANE="/home/nea/ensemble-src/scripts/upgrade"
SERVICE_USER="ensemble"
TAG="ensemble-promote"

# The account that invoked sudo (the wrapper itself runs as root). When run
# from a root session without sudo, falls back to the effective user (root).
invoker="${SUDO_USER:-$(id -un)}"

[ "$(id -u)" -eq 0 ] || { echo "$TAG: must be invoked via sudo (root)" >&2; exit 1; }
[ "$#" -ge 1 ] || { echo "usage: sudo $0 <allowlisted-script> [args...]" >&2; exit 64; }

script="$1"; shift

# ── C1 gate 1: exact enumerated allowlist ────────────────────────────────
case "$script" in
    "$DEV_LANE/promote.sh"|"$DEV_LANE/rollback.sh"|"$DEV_LANE/restart.sh") ;;
    "$INSTALL_DIR"/releases/*/scripts/upgrade/promote.sh)               ;;
    "$INSTALL_DIR"/current/scripts/upgrade/promote.sh)                  ;;
    *)
        echo "$TAG: REFUSED (C1) — script not on the enumerated allowlist: $script" >&2
        logger -t "$TAG" -p daemon.warning \
            "C1 refusal: non-allowlisted path: ${script} (invoker=${invoker})"
        exit 77
        ;;
esac

[ -f "$script" ] || { echo "$TAG: script not found: $script" >&2; exit 66; }

# ── C1 gate 2: invocation-time writability refusal ──────────────────────
# Refuse if the script is group- or other-writable, or owner-writable while
# owned by the invoking user. Rationale: the dev checkout is nea-writable by
# design; an agent-compromised script must never execute as the service user.
perm="$(stat -c '%A' "$script")"
owner="$(stat -c '%U' "$script")"
owner_w="${perm:2:1}"; group_w="${perm:5:1}"; other_w="${perm:8:1}"
if [ "$group_w" = "w" ] || [ "$other_w" = "w" ] \
   || { [ "$owner_w" = "w" ] && [ "$owner" = "$invoker" ]; }; then
    echo "$TAG: REFUSED (C1) — script writable by invoking user/group/other: $script (owner=${owner} mode=${perm} invoker=${invoker})" >&2
    logger -t "$TAG" -p daemon.warning \
        "C1 refusal: writable script: ${script} (owner=${owner} mode=${perm} invoker=${invoker})"
    exit 76
fi

logger -t "$TAG" -p daemon.info \
    "promote starting as ${SERVICE_USER}: ${script} $* (invoked by ${invoker}[$$])"

exec runuser -u "$SERVICE_USER" -- env HOME="$INSTALL_DIR" bash "$script" "$@"
