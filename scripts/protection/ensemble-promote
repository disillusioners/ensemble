# Usage: sudo /usr/local/bin/ensemble-promote <allowlisted-script> [args...]
# Exit codes: 0 ok | 1 not-root | 64 usage | 66 not-found/uncanonicalizable |
#             76 invoker-controlled script (C1/NEW-1 refusal) |
#             77 not-allowlisted (C1 refusal)
# ============================================================================
set -euo pipefail

INSTALL_DIR="/home/nea/agents-ensemble"
DEV_LANE="/home/nea/ensemble-src/scripts/upgrade"
SERVICE_USER="ensemble"
TAG="ensemble-promote"

# The account that invoked sudo (the wrapper itself runs as root). When run
# from a root session without sudo, falls back to the effective user (root).
invoker="${SUDO_USER:-$(id -un)}"

[ "$(id -u)" -eq 0 ] || { echo "$TAG: must be invoked via sudo (root)" >&2; exit 1; }
[ "$#" -ge 1 ] || { echo "usage: sudo $0 <allowlisted-script> [args...]" >&2; exit 64; }

raw="$1"; shift

# ── NEW-2 gate: canonicalize BEFORE the allowlist match ─────────────────
# The case-pattern * crosses "/"; only the canonical path (symlinks, dots
# and dot-dots resolved) may be matched. A path that cannot be canonicalized
# is refused here — fail-closed, journaled.
script="$(readlink -f -- "$raw" 2>/dev/null || true)"
if [ -z "$script" ]; then
    echo "$TAG: REFUSED — cannot canonicalize script path: $raw" >&2
    logger -t "$TAG" -p daemon.warning \
        "NEW-2 refusal: uncanonicalizable path: ${raw} (invoker=${invoker})"
    exit 66
fi

# ── C1 gate 1: exact enumerated allowlist (canonical paths only) ────────
case "$script" in
    "$DEV_LANE/promote.sh"|"$DEV_LANE/rollback.sh"|"$DEV_LANE/restart.sh") ;;
    "$INSTALL_DIR"/releases/*/scripts/upgrade/promote.sh)               ;;
    "$INSTALL_DIR"/current/scripts/upgrade/promote.sh)                  ;;
    *)
        echo "$TAG: REFUSED (C1) — script not on the enumerated allowlist: $script (from: $raw)" >&2
        logger -t "$TAG" -p daemon.warning \
            "C1 refusal: non-allowlisted path: ${script} (raw=${raw} invoker=${invoker})"
        exit 77
        ;;
esac

[ -f "$script" ] || { echo "$TAG: script not found (canonical): $script" >&2; exit 66; }

# ── C1 gate 2 / NEW-1: invoker-control refusal ──────────────────────────
# Refuse when the script is group- or other-writable, or when it is owned by
# the invoking user — UNCONDITIONALLY (NEW-1): the owner write bit is not
# consulted, because chmod needs ownership, not write permission. A self-
# owned chmod-444 script remains fully under the invoker's control.
perm="$(stat -c '%A' "$script")"
owner="$(stat -c '%U' "$script")"
group_w="${perm:5:1}"; other_w="${perm:8:1}"
if [ "$group_w" = "w" ] || [ "$other_w" = "w" ] || [ "$owner" = "$invoker" ]; then
    echo "$TAG: REFUSED (C1/NEW-1) — script is invoker-controlled (owned by invoker, or group/other-writable): $script (owner=${owner} mode=${perm} invoker=${invoker})" >&2
    logger -t "$TAG" -p daemon.warning \
        "C1/NEW-1 refusal: invoker-controlled script: ${script} (owner=${owner} mode=${perm} invoker=${invoker})"
    exit 76
fi

logger -t "$TAG" -p daemon.info \
    "promote starting as ${SERVICE_USER}: ${script} $* (invoked by ${invoker}[$$])"

exec runuser -u "$SERVICE_USER" -- env HOME="$INSTALL_DIR" bash "$script" "$@"
