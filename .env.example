# ==============================================
# Ensemble Daemon Configuration
# ==============================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ---------------------------------------------
# Required: OpenAI API Configuration
# ---------------------------------------------
# Your OpenAI API key (required)
OPENAI_API_KEY=your-api-key-here

# ---------------------------------------------
# Optional: OpenAI API Configuration
# ---------------------------------------------
# Base URL for OpenAI API (default: https://api.openai.com/v1)
# Use this to point to a custom endpoint or proxy
OPENAI_BASE_URL=https://api.openai.com/v1

# Model to use (default: gpt-4)
# Options: gpt-4, gpt-4-turbo, gpt-3.5-turbo, etc.
OPENAI_MODEL=gpt-4

# Model for title generation (optional, falls back to OPENAI_MODEL)
# Use a smaller/cheaper model for cost efficiency on title generation
# OPENAI_MODEL_TITLE=gpt-3.5-turbo

# Model for keyword extraction from outgoing opencode prompts (optional, falls
# back to OPENAI_MODEL). Set to "quick" to mirror the explorer agent's
# llm_model for cost/speed on context preloading.
# OPENAI_MODEL_KEYWORDS=quick

# Models for which reasoning_content from a previous turn must be echoed back
# in subsequent assistant messages. Case-insensitive substring match against
# the model name. Required by DeepSeek's thinking-mode API for tool-calling
# turns (https://api-docs.deepseek.com/guides/thinking_mode).
# Accepts comma-separated values (e.g. "deepseek,glm") or a JSON array
# (e.g. '["deepseek","glm"]'). Default: "deepseek".
# OPENAI_REASONING_ECHO_MODELS=deepseek

# Models allowed as instance model overrides at spawn time. Case-insensitive
# exact match against the override model name. Empty = all models allowed
# (no restriction). Accepts comma-separated values (e.g. "gpt-4,gpt-4o") or a
# JSON array (e.g. '["gpt-4","gpt-4o"]'). Default: empty list (no restriction
# unless configured in config.yaml).
# OPENAI_ALLOWED_MODELS=gpt-4,gpt-4o,gpt-4o-mini,gpt-4-turbo,gpt-3.5-turbo,o1-mini,o1-preview

# ---------------------------------------------
# Optional: Server Configuration
# ---------------------------------------------
# Host to bind to (default: 0.0.0.0)
HOST=0.0.0.0

# Port to listen on (default: 8079)
PORT=8079

# ---------------------------------------------
# Optional: Logging Configuration
# ---------------------------------------------
# Log level for third-party libs (default: info)
LOG_LEVEL=info

# Log level for daemon modules (default: info)
# Options: debug, info, warning, error
LOG_LEVEL_DAEMON=info

LIGHTRAG_HOST=http://lightrag.lightrag.svc.cluster.local:9621
LIGHTRAG_API_KEY=your-key-here

# RAG_IS_REQUIRED unset → unchanged: single attempt, disable on failure.
# RAG_IS_REQUIRED=true (or 1/yes/on) → 2 attempts; on both-fail, exit with code 1 and an error log.

# PostgreSQL Configuration (for migration testing)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ensemble_dev
POSTGRES_USER=ensemble
POSTGRES_PASSWORD=