# ==============================================
# Ensemble Daemon Configuration
# ==============================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ---------------------------------------------
# Required: OpenAI API Configuration
# ---------------------------------------------
# Your OpenAI API key (required)
OPENAI_API_KEY=your-api-key-here

# ---------------------------------------------
# Optional: OpenAI API Configuration
# ---------------------------------------------
# Base URL for OpenAI API (default: https://api.openai.com/v1)
# Use this to point to a custom endpoint or proxy
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional HA fallback endpoint — same proxy backend in another datacenter
# (same API key, model names, API surface). When unset, the system uses
# ONLY OPENAI_BASE_URL and behavior is identical to the pre-HA system.
# When set, transient / timeout / empty-choices failures on the primary
# trigger a one-shot swap to this URL within the same invoke cycle.
# Sticky-on-success: after a successful failover the client stays on the
# backup (both endpoints serve the same backend); the controller returns
# to primary after the NEXT invoke's first attempt completes, regardless
# of whether that attempt succeeds or fails on backup.
# OPENAI_BASE_URL_BACKUP=https://llm.daoduc.org/v1

# Model to use (default: gpt-4)
# Options: gpt-4, gpt-4-turbo, gpt-3.5-turbo, etc.
OPENAI_MODEL=gpt-4

# Model for title generation (optional, falls back to OPENAI_MODEL)
# Use a smaller/cheaper model for cost efficiency on title generation
# OPENAI_MODEL_TITLE=gpt-3.5-turbo

# Model for keyword extraction from outgoing prompts (optional, falls
# back to OPENAI_MODEL). Set to "quick" to mirror the explorer agent's
# llm_model for cost/speed on context preloading.
# OPENAI_MODEL_KEYWORDS=quick

# Models for which reasoning_content echo is DISABLED: reasoning_content from
# a previous turn is echoed back for every model EXCEPT those whose name
# case-insensitively substring-matches an entry here (e.g. providers that
# reject the field with a 400). Accepts comma-separated values
# (e.g. "gpt-4o,claude") or a JSON array (e.g. '["gpt-4o","claude"]').
# Default: empty (all models echo).
# OPENAI_REASONING_ECHO_DISABLED_MODELS=

# Models allowed as instance model overrides at spawn time. Case-insensitive
# exact match against the override model name. Empty = all models allowed
# (no restriction). Scoped to the four spawn-time selection flows (spawn
# model= override, weighted llm_models pool filter, spawn_councilor
# validation, session-restore re-validation); purpose-bound models
# (model_title, model_keywords, model_vision, compaction, skill_evolution)
# are unaffected. Accepts comma-separated values (e.g. "gpt-4,gpt-4o") or a
# JSON array (e.g. '["gpt-4","gpt-4o"]'). Default (as shipped in config.yaml):
# agentic,coding,coding2,vision,img-gen,decision.
# OPENAI_SELECTABLE_MODELS=gpt-4,gpt-4o,gpt-4o-mini,gpt-4-turbo,gpt-3.5-turbo,o1-mini,o1-preview,vision
# Empty / whitespace-only values behave as unset (default applies);
# to lift restrictions entirely, hardcode `allowed_models: []` in
# config.yaml instead — there is no env var path to unrestricted mode.
# Legacy alias (OPENAI_ALLOWED_MODELS) — still honored when the new name is
# unset, but logs a one-shot deprecation warning at startup. Rename your env
# var to OPENAI_SELECTABLE_MODELS to silence the warning.
# Default-applied WARNING (sel-default-20260927): when neither this var nor
# the legacy alias is set, the daemon logs a one-shot WARNING at startup
# naming the default list. Set OPENAI_SELECTABLE_MODELS explicitly (even
# to the current default value) to silence it.

# ---------------------------------------------
# Optional: Server Configuration
# ---------------------------------------------
# Host to bind to (default: 0.0.0.0)
HOST=0.0.0.0

# Port to listen on (default: 8079)
PORT=8079

# ---------------------------------------------
# Optional: Logging Configuration
# ---------------------------------------------
# Log level for third-party libs (default: info)
LOG_LEVEL=info

# Log level for daemon modules (default: info)
# Options: debug, info, warning, error
LOG_LEVEL_DAEMON=info

LIGHTRAG_HOST=http://lightrag.lightrag.svc.cluster.local:9621
LIGHTRAG_API_KEY=your-key-here

# RAG_IS_REQUIRED unset → unchanged: single attempt, disable on failure.
# RAG_IS_REQUIRED=true (or 1/yes/on) → 2 attempts; on both-fail, exit with code 1 and an error log.

# PostgreSQL Configuration (for migration testing)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ensemble_dev
POSTGRES_USER=ensemble
POSTGRES_PASSWORD=

# ---------------------------------------------
# Skill Evolution System
# ---------------------------------------------
# Field names mirror daemon/config.py:SkillEvolutionConfig (env_prefix="SKILL_EVOLUTION_").
# Unset values fall back to the defaults in config.yaml.
#
# Embedding configuration
SKILL_EVOLUTION_EMBEDDING_MODEL=text-embedding-3-small
SKILL_EVOLUTION_EMBEDDING_DIMENSIONS=1536
SKILL_EVOLUTION_EMBEDDING_API_KEY=
SKILL_EVOLUTION_EMBEDDING_BASE_URL= 

# Evolution models (blank → falls back to main OPENAI_MODEL)
SKILL_EVOLUTION_ANALYSIS_MODEL=
SKILL_EVOLUTION_EVOLUTION_MODEL=

# Stage-3 selector model (blank → literal "quick" — NOT the main OPENAI_MODEL)
SKILL_EVOLUTION_SELECTOR_MODEL=

# A/B testing
SKILL_EVOLUTION_AB_SAMPLE_SIZE=10
SKILL_EVOLUTION_AB_MIN_DIFFERENCE=0.15
SKILL_EVOLUTION_MAX_EXTENSIONS=3

# Injection
SKILL_EVOLUTION_MAX_INJECT_SKILLS=2
SKILL_EVOLUTION_MIN_SCORE_FULL_INJECT=0.7
SKILL_EVOLUTION_MIN_SCORE_LOW_MATCH=0.3
SKILL_EVOLUTION_BM25_TOP_K=10
SKILL_EVOLUTION_LLM_SELECT_TOP_K=5

# Triggers
SKILL_EVOLUTION_DEFAULT_TASK_COUNT_THRESHOLD=20
SKILL_EVOLUTION_DEFAULT_DAILY_SCAN_HOUR=3
SKILL_EVOLUTION_METRIC_SCAN_INTERVAL_HOURS=24.0

# Capture thresholds
SKILL_EVOLUTION_CAPTURE_MIN_ITERATIONS=5
SKILL_EVOLUTION_CAPTURE_MIN_DURATION_SECONDS=60

# ---------------------------------------------
# Optional: Plane iframe integration
# ---------------------------------------------
# Base URL for the Plane instance. Serves BOTH the iframe page AND
# the project sync REST API. When set, project creation auto-syncs to Plane.
# REST API: {PLANE_BASE_URL}/api/v1/workspaces/{PLANE_MCP_WORKSPACE_SLUG}/projects/
# PLANE_BASE_URL=https://plane.example.com

# REST API key for Plane project sync (separate from PLANE_MCP_API_KEY).
# Mint via Plane UI → workspace Settings → API Tokens → "+ Add API Token".
# Sent as the X-Api-Key header. Required for plane_http_client auth.
# Leave blank to disable REST sync (PlaneHttpClient.is_available()=False).
# PLANE_API_KEY=plane_api_your_rest_api_key_here

# ---------------------------------------------
# Optional: Plane MCP (Project Manager agent)
# ---------------------------------------------
PLANE_MCP_URL=https://mcp.ensem.dev/plane/http/api-key/mcp
PLANE_MCP_API_KEY=plane_api_your_api_key_here
PLANE_MCP_WORKSPACE_SLUG=your-workspace-slug

# ---------------------------------------------
# Optional: Injected-notes absorb kill-switch
# ---------------------------------------------
# Default ON; =0 restores legacy preserve-forever hoisting for injected notes; invalid values fail at boot
# ENSEMBLE_INJECTED_NOTES_ABSORB=

# ---------------------------------------------
# Optional: Ambient shared-meta-KV on system-default projects
# ---------------------------------------------
# Default ON — first turns on __system_default__-project instances surface a
# [SYSTEM CONTEXT: Shared Meta KV] block when the tree-root partition has rows.
# =0 restores the pre-fix suppression (scope-guide-only, no KV fetch);
# restart required to flip. Invalid non-empty values fail at boot.
# ENSEMBLE_KV_AMBIENT_SYSTEM_DEFAULT_ENABLED=

# Ambient KV per-turn freshness (default ON; restart required).
# =0 reverts to cadence-only: keep turn-1 block, never refresh.
# ENSEMBLE_AMBIENT_KV_FRESH=

# ---------------------------------------------
# Optional: Image generation tool (generate_image)
# ---------------------------------------------
# IMAGE_GEN_MODEL — purpose-bound model id for the generate_image agent tool.
# Unset/empty falls back to the purpose-id "img-gen" (the proxy resolves
# purpose → real provider/model+credentials; matches the "vision"
# OPENAI_MODEL_VISION literal-fallback pattern at
# daemon/plugin_subsystem/opendesign/generate.py:709-727). Env value wins
# when set. Value = the proxy-registered CLIENT-FACING model id (e.g.
# minimax-image-01); the proxy rewrites it to its internal upstream alias.
# NEVER falls back to OPENAI_MODEL (the 2026-10-07 occ-3 wrong-model class
# of bug, prevented by construction).
# IMAGE_GEN_MODEL=minimax-image-01
# IMAGE_GEN_BASE_URL — optional; defaults to OPENAI_BASE_URL (same proxy lane).
# IMAGE_GEN_API_KEY — optional; defaults to OPENAI_API_KEY (existing key reused,
# never minted).
# IMAGE_GEN_TIMEOUT_S — optional; POST-phase wall-clock cap in seconds.
# Default 240, clamped to [30, 300]. The live proxy's own deadline (120s)
# fires first.

# ---------------------------------------------
# Optional: Decision-purpose consumer family
# ---------------------------------------------
# DECISION_MODEL — purpose-bound model id reserved for the
# decision-purpose consumer family. No current consumer reads this env
# var directly (the "decision" purpose-id is currently used only as a
# spawn-time llm_model= override value, mirrored in
# daemon/config.py::_ALLOWED_MODELS_DEFAULT). When a consumer is added
# in a future commission, the same env-default pattern as IMAGE_GEN_MODEL
# will apply: unset/empty ⇒ falls back to the "decision" purpose-id; env
# value wins when set. NEVER falls back to OPENAI_MODEL.

# ---------------------------------------------
# Optional: remote-hands center gateway (SPEC.md v0.1)
# ---------------------------------------------
# The gateway is the CENTER of the remote-hands protocol: a controlled
# machine (mcps_client) dials OUT to this daemon over WebSocket and the
# daemon brokers the session and forwards the MCP traffic.
#
# MCPS_GATEWAY_ENABLED — THE KILL SWITCH. DEFAULT OFF. While it is off
# the WebSocket route is NOT REGISTERED AT ALL (the daemon answers 404
# on the path — it is not "registered but rejecting"), and the four
# mcp_rpc_* agent tools refuse with a typed error.
# MCPS_GATEWAY_ENABLED=1
#
# MCPS_GATEWAY_PATH — the route path. Default /api/mcps-gateway/ws.
# MCPS_GATEWAY_PATH=/api/mcps-gateway/ws
#
# MCPS_GATEWAY_TOKENS — comma-separated ENROLLMENT tokens. EMPTY means
# NOBODY may enroll (fail closed). The comparison is constant-time
# (hmac.compare_digest); a refused upgrade answers HTTP 401 — never 403.
# MCPS_GATEWAY_TOKENS=change-me-1,change-me-2
#
# MCPS_GATEWAY_ALLOWED_MACHINES — comma-separated machine ids. EMPTY
# means every AUTHENTICATED machine is enrolled; a non-empty list is an
# allowlist (a machine outside it gets MACHINE_NOT_ENROLLED). This is
# the v0.2 ACL placeholder.
# MCPS_GATEWAY_ALLOWED_MACHINES=mach_9f3c21ab
#
# The three heartbeat parameters of SPEC §3.3 — all three are advertised
# in the hello result and the client adopts them.
# MCPS_GATEWAY_HEARTBEAT_INTERVAL_MS=15000
# MCPS_GATEWAY_HEARTBEAT_TIMEOUT_MS=45000
# MCPS_GATEWAY_CLIENT_DEAD_DETECT_MS=45000
#
# MCPS_GATEWAY_COMMAND_TIMEOUT_MS — the CENTER's own bound on how long
# it waits for the machine to answer a tools/call.
# MCPS_GATEWAY_COMMAND_TIMEOUT_MS=30000
#
# MCPS_GATEWAY_SESSION_TTL_MS / MCPS_GATEWAY_SESSION_IDLE_TIMEOUT_MS —
# the center owns the session TTL and the idle timeout (the client
# publishes expires_at_ms but never enforces it).
# MCPS_GATEWAY_SESSION_TTL_MS=3600000
# MCPS_GATEWAY_SESSION_IDLE_TIMEOUT_MS=300000
#
# MCPS_GATEWAY_AUDIT_ENABLED — the remote-command audit (§8.4). The sink
# is the DB table mcp_gateway_audit; the arguments are HASHED, never
# stored.
# MCPS_GATEWAY_AUDIT_ENABLED=1

# ─────────────────────────────────────────────────────────────────────────────
# wedge-capture evidence instrumentation (2026-10-22)
#
# An AUTOMATIC, EVIDENCE-ONLY instrument: when the daemon wedges, it
# records what it saw (all-thread stacks, per-thread CPU, loop lag,
# GC/RSS, saver-pool counters, the DB-side executing turns, the
# readiness composite and the slow-saver-op ledger) into a capture
# directory, plus ONE additive metadata row.
#
# IT FIXES NOTHING. A capture is EVIDENCE, never a remedy.
#
# The 15 knobs. All are read ONCE at watchdog start.
#
# ENSEMBLE_WEDGE_CAPTURE_ENABLED — the KILL SWITCH. 1 (default) arms
# the watchdog; 0 disarms it AND refuses a manual capture with the
# typed reason ``watchdog_disabled``.
# ENSEMBLE_WEDGE_CAPTURE_ENABLED=1
#
# ENSEMBLE_WEDGE_CAPTURE_DIR — the capture root. Default
# <data_dir>/wedge-captures (ENSEMBLE_DATA_DIR > DATA_DIR > ./data).
# Never inside the repo, never inside a release dir.
# ENSEMBLE_WEDGE_CAPTURE_DIR=./data/wedge-captures
#
# ENSEMBLE_WEDGE_CAPTURE_CPU_PCT — the PROCESS CPU threshold, as a
# percentage of ONE core (the value may exceed 100). The incident
# observed 95-107% of one core.
# ENSEMBLE_WEDGE_CAPTURE_CPU_PCT=95
#
# ENSEMBLE_WEDGE_CAPTURE_CPU_SUSTAIN_S — the CPU trigger's WALL-TIME
# sustain window, in seconds.
# ENSEMBLE_WEDGE_CAPTURE_CPU_SUSTAIN_S=30
#
# ENSEMBLE_WEDGE_CAPTURE_LAG_S — the event-loop lag threshold, in
# seconds. MUST be strictly greater than the sample interval (a
# healthy daemon measures ~one tick of lag); a violating value falls
# back to the default with a warning.
# ENSEMBLE_WEDGE_CAPTURE_LAG_S=5.0
#
# ENSEMBLE_WEDGE_CAPTURE_LAG_SUSTAIN_S — the lag trigger's WALL-TIME
# sustain window, in seconds.
# ENSEMBLE_WEDGE_CAPTURE_LAG_SUSTAIN_S=15
#
# ENSEMBLE_WEDGE_CAPTURE_THREAD_CONCENTRATION_PCT — one thread's share
# of the process CPU that counts as concentration. The ratio is only
# evaluated when the process actually burned CPU (an absolute 5%-of-
# one-core floor), so a near-idle daemon cannot manufacture a hit.
# ENSEMBLE_WEDGE_CAPTURE_THREAD_CONCENTRATION_PCT=85
#
# ENSEMBLE_WEDGE_CAPTURE_SAMPLE_INTERVAL_S — the sampler cadence, in
# seconds. Minimum 0.2.
# ENSEMBLE_WEDGE_CAPTURE_SAMPLE_INTERVAL_S=1.0
#
# ENSEMBLE_WEDGE_CAPTURE_COOLDOWN_S — the per-reason cooldown between
# captures, in seconds (measured from the START of the previous
# capture). A CPU episode and a lag episode in the same window are
# TWO different shapes and produce two captures.
# ENSEMBLE_WEDGE_CAPTURE_COOLDOWN_S=300
#
# ENSEMBLE_WEDGE_CAPTURE_DEADLINE_S — the whole-capture wall-clock
# budget, in seconds. A step whose budget is exhausted is skipped and
# recorded as skipped:budget.
# ENSEMBLE_WEDGE_CAPTURE_DEADLINE_S=20
#
# ENSEMBLE_WEDGE_CAPTURE_MAX_CAPTURES — the retention COUNT cap. The
# capture DIRECTORIES are the authority (never the table), so an
# orphan capture is still pruned.
# ENSEMBLE_WEDGE_CAPTURE_MAX_CAPTURES=20
#
# ENSEMBLE_WEDGE_CAPTURE_MAX_AGE_HOURS — the retention AGE cap.
# ENSEMBLE_WEDGE_CAPTURE_MAX_AGE_HOURS=168
#
# ENSEMBLE_WEDGE_CAPTURE_MAX_DISK_MB — the retention DISK cap.
# ENSEMBLE_WEDGE_CAPTURE_MAX_DISK_MB=512
#
# ENSEMBLE_WEDGE_CAPTURE_SLOW_SAVER_MS — the stall-ledger cut, in
# milliseconds. A saver op at or above this duration is recorded in
# the bounded ledger that the capture reads.
# ENSEMBLE_WEDGE_CAPTURE_SLOW_SAVER_MS=5000
#
# ENSEMBLE_WEDGE_CAPTURE_OBJECT_CENSUS — the O(heap) object census.
# DEFAULT OFF (it walks the heap, and the live process holds a large
# blob footprint). At most once per capture when enabled.
# ENSEMBLE_WEDGE_CAPTURE_OBJECT_CENSUS=0
#
# ── the read-back surfaces ──────────────────────────────────────────────
#
# The admin API lives under /api/wedge-captures:
#   GET  /api/wedge-captures              — the capture list
#   GET  /api/wedge-captures/{capture_id} — one capture's full payload
#   POST /api/wedge-captures/capture      — a MANUAL capture (202 + a
#                                            pre-allocated id; the
#                                            watchdog services it on
#                                            its next tick)
#   GET  /api/wedge-captures/status       — the watchdog status + the
#                                            effective auto-continue mode
#
# The read routes require the ``maintenance:read`` scope (auth-ON only;
# the scope dependency is inert when auth is OFF). The operator CLI is
# a THIN client over that API:
#   python3 scripts/wedge_capture.py list
#   python3 scripts/wedge_capture.py capture
#   python3 scripts/wedge_capture.py get <capture_id>
#   python3 scripts/wedge_capture.py status
#
# The agent-facing read-only tools (wedge_capture_list / wedge_capture_get)
# are a PRIVILEGED category: ``wedge-capture`` is allow-listed to
# ari / leader / maintenancer only.
