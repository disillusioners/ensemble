<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Enter passcode</title>
  <style nonce="b400d420022c4f0228a76dd943255b7e">* { box-sizing: border-box; }
html, body { margin: 0; padding: 0; background: #fafafa; color: #222; font-family: system-ui, -apple-system, "Segoe UI", sans-serif; }
.wrap { max-width: 480px; margin: 0 auto; padding: 24px 16px; }
h1 { font-size: 20px; margin: 0 0 12px 0; }
p { font-size: 15px; line-height: 1.5; margin: 0 0 16px 0; }
label { display: block; font-size: 14px; margin: 0 0 6px 0; }
input[type="text"] {
  display: block; width: 100%; padding: 12px;
  font-size: 22px; letter-spacing: 4px; text-align: center;
  border: 1px solid #ccc; border-radius: 4px; background: #fff;
  font-family: ui-monospace, "SF Mono", Menlo, monospace;
}
button {
  display: block; width: 100%; margin-top: 12px; padding: 12px;
  font-size: 15px; background: #2563eb; color: #fff;
  border: 0; border-radius: 4px; cursor: pointer;
}
button:hover { background: #1d4ed8; }
.error { color: #b91c1c; margin-top: 12px; font-size: 14px; }
.note { color: #555; font-size: 13px; margin-top: 16px; }
</style>
</head>
<body>
  <div class="wrap">
<h1>Enter passcode</h1>
<p>Enter the 6-character passcode to view this document.</p>
<form method="post" action="/views/public/tmp-images/8f820b5fa8934ae19b9da54f9c040cab" autocomplete="off">
  <label for="code">Passcode</label>
  <input type="text" id="code" name="code" inputmode="latin" pattern="[a-zA-Z0-9]{6}" maxlength="6" minlength="6" required autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false">
  <button type="submit">Submit</button>
</form>
<p class="note">Path: /tmp-images/8f820b5fa8934ae19b9da54f9c040cab</p>

  </div>
</body>
</html>
