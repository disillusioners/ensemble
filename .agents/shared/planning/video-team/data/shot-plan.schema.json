{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agents-ensemble.local/planning/video-team/shot-plan.schema.json",
  "title": "Video Team Shot Plan",
  "description": "Schema'd shot plan (architecture.md section 5.3 / section 9). Authored by video-producer; reviewed as a DATA DIFF (one turn). beat_sha = sha256 over the canonical serialization (sorted keys, 2-space indent, no timestamps) of the beat's subtree of beats[].",
  "type": "object",
  "required": ["schema_version", "project_id", "profile", "video", "beats"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "project_id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 48},
    "profile": {"enum": ["fast-demo", "film+goldens"]},
    "video": {
      "type": "object",
      "required": ["title", "fps", "cap_s", "aspects", "silent"],
      "additionalProperties": false,
      "properties": {
        "title": {"type": "string", "maxLength": 120},
        "fps": {"enum": [24, 30, 60]},
        "cap_s": {"type": "number", "exclusiveMinimum": 0, "maximum": 90, "description": "Hard duration cap in seconds; locked 1:30 maximum (preflight P1 reads this per lane profile)."},
        "aspects": {"type": "array", "minItems": 1, "items": {"enum": ["16x9"]}, "description": "v1 deliverable is 1920x1080 16:9 only; locked no-mobile-framing decision."},
        "silent": {"const": true, "description": "Locked SILENT decision; never voiceover."}
      }
    },
    "beats": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/beat"}
    }
  },
  "$defs": {
    "beat": {
      "type": "object",
      "required": ["id", "surface", "route", "state", "actions", "duration_frames"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 48},
        "surface": {"enum": ["sider", "bottom-bar", "modal", "popup", "dashboard"]},
        "route": {"type": "string", "minLength": 1},
        "state": {
          "type": "object",
          "required": ["requires", "asserts"],
          "additionalProperties": false,
          "properties": {
            "requires": {"type": "array", "items": {"type": "string"}},
            "asserts": {"type": "array", "items": {"type": "string"}, "description": "The beat's intent; G-PLAN re-judges these after any product change."}
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "at_frame"],
            "additionalProperties": true,
            "properties": {
              "type": {"enum": ["navigate", "click", "hover", "drag", "type", "key", "wait_for", "wait_frames", "assert", "set_fixture"]},
              "at_frame": {"type": "integer", "minimum": 0, "description": "Absolute virtual-clock frame; compiler rejects overlapping or unsorted at_frame within a beat."}
            }
          }
        },
        "blocks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["block_id"],
            "additionalProperties": false,
            "properties": {
              "block_id": {"enum": ["marching-ants-indicator", "teaching-pointer", "instant-summary-panel"]},
              "params": {"type": "object", "description": "Block params per block-catalog.json; catalog is editable source."}
            }
          }
        },
        "duration_frames": {"type": "integer", "minimum": 12, "maximum": 5400, "description": "max = cap_s (90) x max_fps (60) = 5400, coherent with lane-profiles.json cap_s=90; the prior 1800 ceiling was incoherent for 90 s cuts at 30/60 fps"},
        "camera": {
          "type": "array",
          "description": "Zoom/crop windows over full-frame footage; camera moves are re-encodes, never re-captures.",
          "items": {
            "type": "object",
            "required": ["from_frame", "to_frame", "box"],
            "additionalProperties": false,
            "properties": {
              "from_frame": {"type": "integer", "minimum": 0},
              "to_frame": {"type": "integer", "minimum": 0},
              "box": {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4, "description": "[x, y, w, h] in 1920x1080 frame coordinates."}
            }
          }
        },
        "overlays": {
          "type": "array",
          "description": "Lower-thirds/captions keyed to frame ranges; browser-rendered assets, never ffmpeg drawtext.",
          "items": {
            "type": "object",
            "required": ["id", "from_frame", "to_frame", "text"],
            "additionalProperties": false,
            "properties": {
              "id": {"type": "string"},
              "from_frame": {"type": "integer", "minimum": 0},
              "to_frame": {"type": "integer", "minimum": 0},
              "text": {"type": "string", "maxLength": 200},
              "sub": {"type": "string", "maxLength": 200}
            }
          }
        },
        "aspects": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "viewport", "dpr"],
            "additionalProperties": false,
            "properties": {
              "id": {"const": "16x9"},
              "viewport": {
                "type": "object",
                "required": ["w", "h"],
                "additionalProperties": false,
                "properties": {
                  "w": {"type": "integer", "minimum": 1024, "description": "Preflight P4: no viewport below 1024 (locked decision)."},
                  "h": {"type": "integer", "minimum": 600}
                }
              },
              "dpr": {"enum": [1, 2]},
              "action_overrides": {
                "type": "array",
                "description": "Sparse; index into actions[].",
                "items": {
                  "type": "object",
                  "required": ["action_index"],
                  "additionalProperties": true,
                  "properties": {"action_index": {"type": "integer", "minimum": 0}}
                }
              }
            }
          }
        }
      }
    }
  }
}
