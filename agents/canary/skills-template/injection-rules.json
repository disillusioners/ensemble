{
  "version": "1.0.0",
  "normalisation": "Patterns evaluate the decoded text; control characters preserved for the hidden-unicode rules; regexes bounded (no unbounded lookbehind, no nested quantifiers). Prose rules are case-insensitive; exact-token rules are case-sensitive.",
  "encoded_rescan": "INJ-18: any 200+ char base64-shaped run is strict-decoded (bounded) and the decoded text is rescanned; decoded hits are reported alongside INJ-18.",
  "rules": [
    { "rule_id": "INJ-01", "category": "instruction-override", "severity": "suspect", "confidence": "medium",
      "pattern": "(?i)\\b(?:ignore|disregard|forget)\\s+(?:all\\s+|any\\s+|your\\s+|the\\s+)?(?:previous|prior|earlier|above|preceding)\\s+(?:instructions?|directives?|rules?|prompts?|training)\\b",
      "note": "Override phrasing; FP: security training and style guides quoting the phrase." },
    { "rule_id": "INJ-02", "category": "instruction-override", "severity": "suspect", "confidence": "medium",
      "pattern": "(?i)\\b(?:instructions?|directives?|rules?|system\\s+prompts?)\\s+(?:have|has)\\s+(?:been\\s+)?(?:changed|updated|replaced|revised|overridden|revoked)\\b",
      "note": "Prompt-replacement claims; FP: docs describing prompt versioning." },
    { "rule_id": "INJ-03", "category": "instruction-override", "severity": "suspect", "confidence": "medium",
      "pattern": "(?i)\\b(?:this|these|my)\\s+(?:instructions?|directives?|request|message|task|email|document)\\s+(?:overrides?|supersedes?|takes\\s+(?:precedence|priority)\\s+over|cancels?)\\b",
      "note": "Priority escalation; FP: legitimate priority language in tickets." },
    { "rule_id": "INJ-04", "category": "role-hijack", "severity": "suspect", "confidence": "medium",
      "pattern": "(?i)\\byou\\s+are\\s+now\\s+(?:a|an|the)\\b|\\b(?:adopt|assume|take\\s+on)\\s+the\\s+(?:persona|role|identity|character)\\s+of\\b",
      "note": "Persona reassignment; FP: fiction/roleplay directories discussing personas." },
    { "rule_id": "INJ-05", "category": "role-hijack", "severity": "suspect", "confidence": "medium",
      "pattern": "(?i)\\b(?:the\\s+)?(?:operator|admins?|administrators?|owners?|developers?|maintainers?)\\s+(?:has|have)\\s+(?:been\\s+)?authori[sz]ed\\b|\\b(?:permission|approval|consent)\\s+(?:is|has\\s+been)\\s+(?:granted|given)\\b",
      "note": "Authority impersonation; FP: authorization docs and audit prose." },
    { "rule_id": "INJ-06", "category": "role-hijack", "severity": "hostile", "confidence": "high",
      "pattern": "<\\|(?:system|developer|user)\\|>|(?:^|\\n)\\s*(?:SYSTEM|DEVELOPER)\\s*:|(?:^|\\n)#{1,3}\\s*system\\s*:|<<\\s*SYS\\s*>>|\\[INST\\]",
      "note": "Channel-marker forgery (exact tokens, case-sensitive); FP: parser/lexer test fixtures." },
    { "rule_id": "INJ-07", "category": "tool-urge", "severity": "suspect", "confidence": "medium",
      "pattern": "(?i)\\b(?:run|execute|call|invoke|launch)\\s+(?:the\\s+(?:following|next|below)\\s+)?(?:command|cmd|tool|script|binary|payload)?\\s*[`\"']?\\s*(?:curl|wget|nc|netcat|ssh|bash\\s+-c|sh\\s+-c|python\\s+-c|rm\\s+-rf)\\b",
      "note": "Urge to run a dangerous binary; FP: install docs quoting imperative examples." },
    { "rule_id": "INJ-08", "category": "tool-urge", "severity": "suspect", "confidence": "medium",
      "pattern": "(?i)\\b(?:send|post|upload|forward|transmit|copy)\\s+(?:the\\s+|this\\s+|all\\s+|these\\s+|your\\s+)*(?:data|output|results?|content|files?|env|environment(?:\\s+variables?)?|secrets?|credentials?|keys?|tokens?)\\s+(?:to|via|through|out\\s+to)\\s+(?:my|this|that|the\\s+(?:following|external|remote)|an?\\s+)?(?:external|remote|attacker|webhook|server|host|endpoint|url|https?://)\\b",
      "note": "Exfiltration urging; bare pipe-to-shell install one-liners deliberately NOT matched." },
    { "rule_id": "INJ-09", "category": "tool-urge", "severity": "suspect", "confidence": "medium",
      "pattern": "(?i)\\b(?:don'?t|do\\s+not|never|no\\s+need\\s+to)\\s+(?:ask|confirm|wait\\s+for\\s+(?:approval|confirmation)|seek\\s+(?:permission|approval))\\b|\\bauto[- ]?approv(?:e|al)\\b|\\bskip\\s+the\\s+(?:gate|confirmation|prompt|approval)\\b|\\bwithout\\s+(?:asking|confirmation|approval)\\b",
      "note": "Consent-bypass urging; FP: CI config prose like 'no need to ask'." },
    { "rule_id": "INJ-10", "category": "hidden-unicode", "severity": "hostile", "confidence": "high",
      "pattern": "[\\u202A-\\u202E\\u2066-\\u2069]",
      "note": "Bidi controls; never legitimate in intake text." },
    { "rule_id": "INJ-11", "category": "hidden-unicode", "severity": "hostile", "confidence": "high",
      "pattern": "[\\u200B-\\u200D\\uFEFF]",
      "note": "Zero-width characters; FP: rare copy-paste artifacts." },
    { "rule_id": "INJ-12", "category": "hidden-unicode", "severity": "hostile", "confidence": "high",
      "pattern": "[\uDB40\uDC00-\uDB40\uDC7F]",
      "note": "Unicode tag-block smuggling (U+E0000-E007F); never legitimate in intake." },
    { "rule_id": "INJ-13", "category": "hidden-unicode", "severity": "suspect", "confidence": "high",
      "pattern": "[A-Za-z][\\u0370-\\u03FF\\u0400-\\u04FF]|[\\u0370-\\u03FF\\u0400-\\u04FF][A-Za-z]",
      "note": "Mixed-script adjacency; FP: transliterated brand or multilingual words." },
    { "rule_id": "INJ-14", "category": "markdown-directive", "severity": "suspect", "confidence": "medium",
      "pattern": "(?i)<!--[\\s\\S]{0,400}?(?:ignore|instruction|disregard|override|execute|run|system|admin|password|credential)[\\s\\S]{0,200}?-->",
      "note": "HTML comments carrying directive language; FP: commented-out docs quoting them." },
    { "rule_id": "INJ-15", "category": "markdown-directive", "severity": "suspect", "confidence": "medium",
      "pattern": "(?i)display\\s*:\\s*none[\\s\\S]{0,300}?(?:ignore|instruction|disregard|execute|run)\\b|visibility\\s*:\\s*hidden[\\s\\S]{0,300}?(?:ignore|instruction|disregard|execute|run)\\b|(?:alt|title)\\s*=\\s*[\"'][^\"']{0,200}(?:ignore|instruction|disregard|execute|run)\\b",
      "note": "Hidden render blocks; FP: legitimate collapsible UI sections." },
    { "rule_id": "INJ-16", "category": "markdown-directive", "severity": "hostile", "confidence": "high",
      "pattern": "\\[(?:UNTRUSTED-DATA|SYSTEM NOTE|REPORT SANITY)[^\\]\\n]{0,60}\\]",
      "note": "Delimiter/system-marker spoofing (exact tokens); FP: docs illustrating the fence." },
    { "rule_id": "INJ-17", "category": "secret-request", "severity": "suspect", "confidence": "medium",
      "pattern": "(?i)\\b(?:reveal|show|print|display|dump|send|paste|share|expose|cat|read|open)\\b[^.\\n]{0,60}?(?:\\b(?:api[\\s_-]?keys?|passwords?|passphrases?|secrets?|credentials?|tokens?|environment\\s+variables?)\\b|\\.env\\b)|\\bwhat\\s+is\\s+your\\s+(?:api\\s?key|password|token|secret)\\b",
      "note": "Secret-request phrasing; FP: security reviews discussing key handling." },
    { "rule_id": "INJ-18", "category": "encoded-payload", "severity": "suspect", "confidence": "low",
      "pattern": "[A-Za-z0-9+/]{200,}={0,2}|[0-9a-fA-F]{200,}",
      "note": "Length-gated blob; alone is suspect/low, never hostile; decoded form is rescanned." }
  ]
}
