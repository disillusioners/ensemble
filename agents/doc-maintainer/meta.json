    "color": "accent-amber",
    "version": "1.0.0",
    "llm_models": [
        {"model": "coding", "weight": 100}
    ],
    "skill_injection": true,
    "tools": {
        "allow": [
            "doc_write",
            "comment_edit",
            "read_file",
            "list_directory",
            "glob_files",
            "grep_files",
            "skill_search",
            "shared_context_metadata",
            "time",
            "help"
        ]
    }
}
