# ==============================================================================
# Ensemble Daemon — PRODUCTION environment template
# ==============================================================================
# This file is the tracked TEMPLATE. Copy it to .env.prod (gitignored) and
# fill in your prod values:
#     cp .env.prod.example .env.prod
#
# `make install` stages .env.prod → INSTALL_DIR/.env (the single canonical
# prod env source — ADR-014). The launcher exports it BEFORE running the
# binary, so these values take precedence over anything the binary would
# load itself.
#
# PORT: 9797 is the CANONICAL prod port (D1 FINAL — supersedes earlier
# 8088 references in plan docs). Dev (8079) lives in the dev repo's .env;
# dev and prod always coexist on distinct ports.
# ==============================================================================

# ---------------------------------------------
# Required: OpenAI API Configuration
# ---------------------------------------------
OPENAI_API_KEY=your-prod-api-key-here

# Primary LLM endpoint (proxy or direct)
OPENAI_BASE_URL=https://api.openai.com/v1

# HA fallback endpoint — same proxy backend in another datacenter (same key,
# models, API surface). Transient/timeout/empty-choices failures on the
# primary trigger a one-shot swap within the same invoke cycle. Leave unset
# to disable failover.
OPENAI_BASE_URL_BACKUP=https://your-backup-endpoint.example/v1

# Models
OPENAI_MODEL=your-prod-model
# Optional: cheaper model for title generation (falls back to OPENAI_MODEL)
# OPENAI_MODEL_TITLE=cheap-model
# Optional: keyword-extraction model ("quick" mirrors explorer's llm_model)
# OPENAI_MODEL_KEYWORDS=quick
# Optional: vision-capable model
# OPENAI_MODEL_VISION=vision-model

# Models allowed as instance model overrides at spawn time. Case-insensitive
# exact match against the override model name. Empty = all models allowed
# (no restriction). Scoped to the four spawn-time selection flows (spawn
# model= override, weighted llm_models pool filter, spawn_councilor
# validation, session-restore re-validation); purpose-bound models
# (model_title, model_keywords, model_vision, compaction, skill_evolution)
# are unaffected. Accepts comma-separated values (e.g. "model-a,model-b") or a
# JSON array (e.g. '["model-a","model-b"]'). Default (as shipped in config.yaml):
# agentic,coding,coding2,vision,img-gen,decision.
# OPENAI_SELECTABLE_MODELS=model-a,model-b,model-c,vision
# Empty / whitespace-only values behave as unset (default applies);
# to lift restrictions entirely, hardcode `allowed_models: []` in
# config.yaml instead — there is no env var path to unrestricted mode.
# Legacy alias (OPENAI_ALLOWED_MODELS) — still honored when the new name is
# unset, but logs a one-shot deprecation warning at startup. Rename your env
# var to OPENAI_SELECTABLE_MODELS to silence the warning.
# Default-applied WARNING (sel-default-20260927): when neither this var nor
# the legacy alias is set, the daemon logs a one-shot WARNING at startup
# naming the default list. Set OPENAI_SELECTABLE_MODELS explicitly (even
# to the current default value) to silence it.

# ---------------------------------------------
# Server Configuration
# ---------------------------------------------
# Loopback by default — this is a single-host deployment; expose only if you
# front it with a reverse proxy.
HOST=127.0.0.1

# Canonical prod port (9797 — D1 FINAL). Dev = 8079 (dev repo .env).
PORT=9797

# ---------------------------------------------
# Required: Production PostgreSQL
# ---------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ensemble_prod
POSTGRES_USER=ensemble
POSTGRES_PASSWORD=your-prod-db-password

# ---------------------------------------------
# Optional: Logging
# ---------------------------------------------
# LOG_LEVEL=info
# LOG_LEVEL_DAEMON=info

# ---------------------------------------------
# Optional: /readyz degradation drill knob
# ---------------------------------------------
# Phase-1 readiness drill (ADR-003): set to 1 (or true/yes/on/degraded)
# to force /readyz to degraded (503 + Retry-After) while PRESERVING the
# real component readings — the reason body names this variable. One-way
# by design (can only degrade, never mask a real failure). Read per
# refresh tick (~10s); restart the daemon with it set for a live drill,
# unset (or 0/false — anything else is OFF) to recover. Used by the
# Phase-1 /readyz green→red→green validation and available to operators
# for readiness-alarm rehearsals. A live daemon never restarts on
# /readyz, so this knob can never take the process down.
# ENSEMBLE_READINESS_FORCE_DEGRADED=0

# ---------------------------------------------
# Optional: Injected-notes absorb kill-switch
# ---------------------------------------------
# Default ON; =0 restores legacy preserve-forever hoisting for injected notes; invalid values fail at boot
# ENSEMBLE_INJECTED_NOTES_ABSORB=

# ---------------------------------------------
# Optional: Image generation tool (generate_image)
# ---------------------------------------------
# IMAGE_GEN_MODEL — purpose-bound model id for the generate_image agent tool.
# Unset/empty falls back to the purpose-id "img-gen" (the proxy resolves
# purpose → real provider/model+credentials; matches the "vision"
# OPENAI_MODEL_VISION literal-fallback pattern at
# daemon/plugin_subsystem/opendesign/generate.py:709-727). Env value wins
# when set. Value = the proxy-registered CLIENT-FACING model id (e.g.
# minimax-image-01); the proxy rewrites it to its internal upstream alias.
# NEVER falls back to OPENAI_MODEL (the 2026-10-07 occ-3 wrong-model class
# of bug, prevented by construction).
# IMAGE_GEN_MODEL=minimax-image-01
# IMAGE_GEN_BASE_URL — optional; defaults to OPENAI_BASE_URL (same proxy lane).
# IMAGE_GEN_API_KEY — optional; defaults to OPENAI_API_KEY (existing key reused,
# never minted).
# IMAGE_GEN_TIMEOUT_S — optional; POST-phase wall-clock cap in seconds.
# Default 240, clamped to [30, 300]. The live proxy's own deadline (120s)
# fires first.
#
# LIVE-by-default semantics (image-gen fail-closed flip):
# When OPENAI_BASE_URL + OPENAI_API_KEY both resolve (either via the dedicated
# IMAGE_GEN_* knobs above or via the OPENAI_* fallbacks), the generate_image
# tool is LIVE-by-default — model resolves to the "img-gen" purpose-id and
# image generation calls succeed without any extra env var set. The tool only
# fail-closes (returns image_gen_not_configured) when base or key is UNSET,
# EMPTY, or whitespace-only — the same three states pinned by
# tests/unit/tools/test_image_gen_tool.py. Containment of who-can-call is the
# per-agent `image-gen` tool allow in each agent's meta.json (six consumer
# agents are granted today; critic is NOT granted). Purpose-id parity:
# "img-gen" is in the shipped OPENAI_SELECTABLE_MODELS default
# (agentic,coding,coding2,vision,img-gen,decision) so spawn-time
# llm_model="img-gen" overrides resolve daemon-wide.

# ---------------------------------------------
# Optional: Decision-purpose consumer family
# ---------------------------------------------
# DECISION_MODEL — purpose-bound model id reserved for the
# decision-purpose consumer family. No current consumer reads this env
# var directly (the "decision" purpose-id is currently used only as a
# spawn-time llm_model= override value, mirrored in
# daemon/config.py::_ALLOWED_MODELS_DEFAULT). When a consumer is added
# in a future commission, the same env-default pattern as IMAGE_GEN_MODEL
# will apply: unset/empty ⇒ falls back to the "decision" purpose-id; env
# value wins when set. NEVER falls back to OPENAI_MODEL.
# DECISION_MODEL=decision

# ---------------------------------------------
# Kill switches — features ship ON; set to 0 to disable
# ---------------------------------------------
# ENSEMBLE_SERVICE_TOOL_ENABLED — service/proc tool lane + reconcile sweep; default ON
# ENSEMBLE_PROACTIVE_COMPACTION — proactive context-compaction trigger (P1 pre-dispatch + P1b 95% reactive); default ON
# ENSEMBLE_SYMPTOM_REPAIR_LADDER — master symptom-repair ladder (loop/ghost/truncated/empty rungs); default ON
# ENSEMBLE_REPAIR_LOOP_DURABLE — durable loop-repair carrier enrollment (ladder sub-flag); default ON
# ENSEMBLE_EMPTY_RESPONSE_GUARD — empty LLM-response guard (retry, then truncation fallback); default ON
# ENSEMBLE_KV_AMBIENT_SYSTEM_DEFAULT_ENABLED — ambient shared-meta-KV block on system-default projects; default ON (restart to flip)
# ENSEMBLE_AMBIENT_KV_FRESH — per-turn refresh of the ambient KV block (vs cadence-only); default ON (restart to flip)
# ENSEMBLE_INJECTED_NOTES_ABSORB — answered injected notes absorbed into the compacted span; default ON
# ENSEMBLE_VSCODE_WEBVIEW_CSP_FIX — VSCode webview CSP rewrite (image preview loads via /vscode proxy); default ON
# ENSEMBLE_LEADER_ATTESTATION_LLM_JUDGE_ENABLED — LLM judge on the attestation would-be-deny path; default ON (restart to flip)
# ENSEMBLE_AUTO_CONTINUE_RUNNING_ON_RESTART — auto-continue RUNNING instances after daemon restart; default ON
# ENSEMBLE_HARD_REBOOT_BOOT_PASS — boot pass resets stranded 'processing' message rows; default ON
# ENSEMBLE_BOOT_AUTO_CONTINUED_PRESERVE — clear_all preserves auto-continued instances (F-1 arm 3); default ON
# ENSEMBLE_POST_RESTART_ARM_NOTIFY — post-restart auto-wake for armed upgrade runs; default ON
# ENSEMBLE_ORPHAN_F1_ENABLED — orphan-ACTIVE JobItem DEAD-finalization (Pattern f1); default ON (restart to flip)
# ENSEMBLE_DEFER_AUTOPROMOTE_ENABLED — bounded deferred-task unstick/auto-promote (Pattern g); default ON (restart to flip)
# ENSEMBLE_WATCHER_REARM_ON_RESUME — re-arm cancelled watchers on instance resume; default ON (restart to flip)
# ENSEMBLE_INSTANCE_OPS_ENABLED — instance_ops act surface (maintenancer-only); default ON
# ENSEMBLE_REPAIR_ENABLED — ens_db repair tool writes (legacy aliases ENSEMBLE_REPAIR_DISABLED/OFF also honored); default ON
# ENSEMBLE_WEDGE_CAPTURE_ENABLED — wedge-capture diagnostic watchdog (CPU/lag triggers); default ON
# LIMITS_GOVERNOR_RECURSION_GUARD_ENABLED — governor spawn-recursion guard; default ON (restart to flip)
# WATCHOVER_ENABLED — watchover lane global gate (zero-cost short-circuit when off); default ON
# USE_WORKER_POOL — worker/manager thread pools; default ON (false/0/no disables both pools)
# PLANE_SYNC_ENABLED — Plane REST sync (sync service + watchdog + POST + hooks + agent tool); default ON
# PLANE_MCP_ENABLED — builtin Plane MCP server registration; default ON (independent of PLANE_SYNC_ENABLED)
# MCPS_GATEWAY_AUDIT_ENABLED — remote-hands gateway audit-ledger writes; default ON (gateway itself is opt-in — see MCPS_GATEWAY_ENABLED)
# MAINTENANCE_ENDPOINTS_ENABLED — maintenance console endpoints; default ON (boot-read — restart to flip)
# PERSISTENCE_VACUUM_ENABLED — scheduled plain-VACUUM (ANALYZE) maintenance lane (PG-only; kill var for the internal VACUUM_ENABLED constant); default ON
# ENSEMBLE_RESTART_GATE_REQUIRE_READY — /readyz required in the agent-restart gate (live reader: restart.sh); default 1 (0 = report-only)
# WC_REPORT_INTEGRITY_B_TERMINAL_WAITING_GUARD_ENABLED — report-integrity (b) terminal-waiting enforcement (notice injection; =0 = log-only); default ON (D2.5-FLIP landed 2026-10-31); cached — restart required to flip

# ---------------------------------------------
# Opt-in flags — default OFF; set to enable (security/cost-gated)
# ---------------------------------------------
# ENSEMBLE_SKILL_CAPTURE_ENABLED — automatic skill-capture dispatch on task success (LLM cost); default OFF
# ENSEMBLE_SKILL_EVOLUTION_ENABLED — Tier-3 skill evolution job lane (skill_fix dispatch → repo-source edits); default OFF
# LIMITS_METRICS_ENABLED — managed metrics tier (DB override > env > yaml; /metrics live without restart); default OFF
# ENSEMBLE_METRICS_ENABLED — authoritative per-request metrics override (wins over the LIMITS_METRICS_ENABLED chain when set); default OFF
# MCPS_GATEWAY_ENABLED — remote-hands WebSocket gateway (route + mcp_rpc_* tools; NOT registered at all while off); default OFF
# ENSEMBLE_AUTH_ENABLED — OAuth2 auth middleware (pairs with its required key/jwt settings); default OFF
# ENSEMBLE_EMPTY_GUARD_COMPACTION_SKIP — exempt compaction summarizer calls from the empty-response guard; default OFF
# OPENAI_REQUEST_GZIP — gzip outbound LLM request bodies (provider must accept); default OFF
# ENSEMBLE_TMP_IMAGE_DEBUG_LISTING — gated /api/tmp_images health/debug listing (count + oldest mtime only); default OFF
# ENSEMBLE_ALLOW_STALE_SCRIPTS — per-invocation bypass of the upgrade pipeline provenance check (never persist to .env); default OFF
# ENSEMBLE_READINESS_FORCE_DEGRADED — /readyz degradation drill (one-way: 1/true/yes/on/degraded); default OFF
# RESOURCE_MONITOR_PROFILING_ENABLED — on-demand profiler seam on /api/resources; default OFF
# ENSEMBLE_WEDGE_CAPTURE_OBJECT_CENSUS — object census in wedge captures (extra capture cost); default OFF
# BLUEPRINT_DOC_MAINTENANCE_ENABLED — blueprint doc-maintainer workers write docs/ + comments; default OFF
# BLUEPRINT_DOC_MAINTENANCE_COMMIT_ENABLED — atomic build-validation + git-commit after doc writes (requires the flag above); default OFF
# ENSEMBLE_MISSION_RECORDS_SCHEDULER_MINT — arms the scheduler-lane record mint (also requires ENSEMBLE_MISSION_RECORDS != off); default OFF per standing product ruling: scheduler lane stays bare (no flip planned PR1-PR3)

# ---------------------------------------------
# Mission-records mode ladder (tri-state — NOT an on/off kill switch; do NOT set =0)
# ---------------------------------------------
# ENSEMBLE_MISSION_RECORDS — tri-state mode ladder: off (no writes) / dry (SHIP DEFAULT: mints write, reads stay legacy) / enforce (adds read-side gates incl. the L3 root-completion hold; boot backfill commits); restart-read, cached at boot (invalid token raises ValueError at boot); NOT an on/off kill switch — do NOT set =0; both current deployments (dev + prod) run enforce per docs/mission-records-enforce-promotion-runbook.md
